# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only, NEVER expose to the browser. Used in API routes/admin actions that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (Dashboard > Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Dashboard > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: live currency conversion (exchangerate-api.com free tier) ---
# If omitted, the site falls back to the static rates in lib/currency.ts
EXCHANGE_RATE_API_KEY=
